# ─── Base de datos ──────────────────────────────────────────────────────────
# Obtén tu connection string desde Neon (neon.tech) o Supabase (supabase.com)
# Formato Neon:     postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Formato Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
